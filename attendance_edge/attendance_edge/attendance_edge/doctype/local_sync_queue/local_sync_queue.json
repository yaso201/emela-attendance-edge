{
  "name": "Local Sync Queue",
  "module": "Attendance Edge",
  "doctype": "DocType",
  "autoname": "LSQ-.YYYY.-.#####",
  "description": "Persistent local sync queue for event replay. Ref: D4 TODO-ATT-DATA-LOCAL-006.",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    {"fieldname": "event_id", "fieldtype": "Data", "label": "Event ID", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "local_event", "fieldtype": "Link", "label": "Local Attendance Event", "options": "Local Attendance Event"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nSent\nAcknowledged\nFailed", "default": "Pending", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "attempt_count", "fieldtype": "Int", "label": "Attempt Count", "default": "0"},
    {"fieldname": "next_retry_at", "fieldtype": "Datetime", "label": "Next Retry At"},
    {"fieldname": "last_attempt_at", "fieldtype": "Datetime", "label": "Last Attempt At"},
    {"fieldname": "last_error", "fieldtype": "Small Text", "label": "Last Error"},
    {"fieldname": "payload_json", "fieldtype": "Long Text", "label": "Payload JSON"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
